# sotaagents-app-proactive-agent: no Sota secret or private key is required.
PORT=8787
# Shared secret used to verify the HMAC-SHA256 signature of inbound Events on
# POST /events/proactive (external webhook source — Req 2.1 / OQ3).
PROACTIVE_WEBHOOK_SECRET=change-me
